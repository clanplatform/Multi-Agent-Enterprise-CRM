# Environment Configuration
# Copy this file to .env and update the values

# ===================
# General
# ===================
NODE_ENV=development
LOG_LEVEL=debug

# ===================
# Database
# ===================
DATABASE_URL=postgresql://crm_user:crm_password@postgres:5432/enterprise_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=enterprise_crm

# ===================
# Redis
# ===================
REDIS_URL=redis://redis:6379

# ===================
# Kafka
# ===================
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=enterprise-crm

# ===================
# Authentication (Keycloak)
# ===================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=enterprise-crm
KEYCLOAK_CLIENT_ID=crm-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ===================
# JWT
# ===================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===================
# OPA (Open Policy Agent)
# ===================
OPA_URL=http://opa:8181

# ===================
# AI/LLM (Ollama)
# ===================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ===================
# Vector Store (Weaviate)
# ===================
WEAVIATE_URL=http://weaviate:8080

# ===================
# Frontend
# ===================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ===================
# Services Ports
# ===================
FRONTEND_PORT=3000
GATEWAY_PORT=4000
LEADS_SERVICE_PORT=5001
DEALS_SERVICE_PORT=5002
TICKETS_SERVICE_PORT=5003
CUSTOMERS_SERVICE_PORT=5004
AGENTS_PORT=5010

# ===================
# Observability
# ===================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
